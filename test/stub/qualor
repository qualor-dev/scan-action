#!/bin/sh
# Test stub for qualor: records its arguments, its environment, the token it got on
# QUALOR_TOKEN_FD and whether git can read the checkout, then exits with STUB_EXIT (for scan, fix
# and dotnet end; 0 by default).
out=/out
name=$(echo "$*" | cut -d' ' -f1-2 | tr ' ' '-')
case $1 in scan) name=scan ;; fix) name=fix ;; esac
{
  printf 'qualor'
  for a in "$@"; do printf ' [%s]' "$a"; done
  echo
} >> "$out/calls"
env | sort > "$out/env-$name"
pwd > "$out/pwd-$name"
echo "${QUALOR_TRIVY_CACHE_DIR-unset}" > "$out/trivy-$name"
if [ -n "${QUALOR_TOKEN_FD:-}" ]; then cat "/dev/fd/$QUALOR_TOKEN_FD"; else echo none; fi > "$out/tokenfd-$name"
if git rev-parse HEAD > /dev/null 2>&1; then echo ok; else echo failed; fi > "$out/git-$name"
if mkdir -p "$QUALOR_TRIVY_CACHE_DIR" 2> /dev/null && : > "$QUALOR_TRIVY_CACHE_DIR/probe" 2> /dev/null; then echo ok; else echo failed; fi > "$out/cachewrite-$name"
code=0
case $name in
  dotnet-begin) mkdir -p .qualor/dotnet ;;
  dotnet-end) rm -rf .qualor/dotnet; code=${STUB_EXIT:-0} ;;
  dotnet-abort) rm -rf .qualor/dotnet ;;
  scan | fix) code=${STUB_EXIT:-0} ;;
esac
exit "$code"
